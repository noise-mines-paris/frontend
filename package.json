{
	"name": "frontend",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"build": "tsc -b && vite build",
		"dev": "vite",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint .",
		"lint:fix": "eslint --fix .",
		"preview": "vite preview",
		"prepare": "husky"
	},
	"dependencies": {
		"preact": "^10.25.4"
	},
	"devDependencies": {
		"@eslint/js": "^9.21.0",
		"@preact/preset-vite": "^2.10.1",
		"eslint": "^9.21.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-react": "^7.37.4",
		"globals": "^16.0.0",
		"husky": "^9.1.7",
		"lint-staged": "^15.4.3",
		"prettier": "3.5.2",
		"typescript": "~5.7.2",
		"typescript-eslint": "^8.24.1",
		"vite": "^6.1.0"
	},
	"lint-staged": {
		"**/*": [
			"eslint",
			"prettier --write --ignore-unknown"
		]
	}
}
